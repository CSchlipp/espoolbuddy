# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is ignored by git (add it to .gitignore).

# WiFi credentials
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# Bambuddy backend
bambuddy_backend_url: "http://192.168.1.100:5000"
bambuddy_api_key: "your-api-key-from-bambuddy-settings"

# ESPHome OTA/API passwords
ota_password: "your-ota-password"
# Generate your own key (for example: `openssl rand -base64 32`).
api_encryption_key: "REPLACE_WITH_YOUR_OWN_KEY_FROM_OPENSSL_RAND_BASE64_32"
